        <div className="cookie-banner" role="dialog">
          <p className="cookie-text">
            🍪 Utilizziamo cookie tecnici essenziali.{' '}
            <a href="#" onClick={(e) => { e.preventDefault(); setShowPrivacy(true); }}>Privacy Policy</a>
          </p>
          <div className="cookie-btns">
            <button className="cookie-reject" onClick={() => setShowCookie(false)}>Rifiuta</button>
            <button className="cookie-accept" onClick={acceptCookie}>Accetta</button>
          </div>
        </div>
      )}

      {/* PRIVACY MODAL */}
      {showPrivacy && (
        <div className="privacy-overlay" onClick={() => setShowPrivacy(false)}>
          <div className="privacy-card" onClick={(e) => e.stopPropagation()}>
            <div className="privacy-head">
              <h2 style={{color:'#fff', fontSize:'1.2rem'}}>Privacy Policy</h2>
              <button onClick={() => setShowPrivacy(false)} style={{background:'none', border:'none', color:'#D4AF37', cursor:'pointer', fontSize:'1.5rem'}}>×</button>
            </div>
            <div className="privacy-body">
              <h3>Informativa Privacy</h3>
              <p>MAVILO DOLCE rispetta la tua privacy. Raccogliamo solo i dati necessari per erogare i nostri servizi.</p>
              <h3>Dati Raccolti</h3>
              <p>Dati di contatto (email, WhatsApp) forniti volontariamente tramite il formulario.</p>
              <h3>Finalità</h3>
              <p>Gestione richieste di preventivo e comunicazioni commerciali, previo consenso.</p>
            </div>
          </div>
        </div>
      )}
    </>
  );
}

const root = document.getElementById('root');
const loader = document.getElementById('loader');

setTimeout(() => {
  if (loader) loader.classList.add('exit');
}, 2500);

ReactDOM.createRoot(root).render(<App />);
</script>

</body>
</html>
